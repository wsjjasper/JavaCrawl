:root {
    --accent: hsl(30, 80%, 52%);
    --accent-light: hsl(30, 90%, 95%);
    --day1: hsl(210, 70%, 50%);
    --day2: hsl(140, 55%, 42%);
    --day3: hsl(25, 75%, 50%);
    --day4: hsl(0, 0%, 40%);
    --text-dark: #1a1a2e;
    --text-light: #f8f9fa;
    --panel-bg: rgba(255, 255, 255, 0.95);
    --panel-bg-dark: rgba(15, 20, 30, 0.92);
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Inter', sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body, html {
    height: 100%;
    font-family: var(--font-body);
    background: #0a0a0a;
    overflow: hidden;
}

/* ============ PROGRESS BAR ============ */
#progress-container {
    position: fixed; top: 0; left: 0; width: 100%; height: 4px;
    background: rgba(255,255,255,0.15); z-index: 1000;
}
#progress-bar {
    height: 100%; width: 0%;
    background: var(--accent);
    transition: width 0.5s ease;
}
#progress-text {
    position: fixed; top: 12px; right: 24px;
    font-size: 0.8rem; font-weight: 600; letter-spacing: 1.5px;
    color: rgba(255,255,255,0.85); z-index: 1000;
    text-shadow: 0 1px 4px rgba(0,0,0,0.7);
    background: rgba(0,0,0,0.35); padding: 4px 12px; border-radius: 4px;
    transition: opacity 0.3s;
}

/* ============ SCROLL SNAP ============ */
.presentation-container {
    height: 100vh; overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    -ms-overflow-style: none; scrollbar-width: none;
}
.presentation-container::-webkit-scrollbar { display: none; }

/* ============ SLIDE BASE ============ */
.slide {
    height: 100vh; width: 100vw;
    scroll-snap-align: start;
    position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}

/* ============ VENUE SLIDES (with background photos) ============ */
.bg-image {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    z-index: 1;
    transition: transform 12s ease-out;
}
.ken-burns { transform: scale(1.08); }
.slide.active .ken-burns { transform: scale(1); }

/* Light overlay — NOT gray. Just enough for text readability */
.overlay-light {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(135deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.45) 100%);
}
.overlay-gradient-bottom {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 100%);
}

/* ============ DRIVING SLIDES (Map as hero) ============ */
.slide-driving {
    background: #111;
}
.map-hero {
    position: absolute; inset: 0; z-index: 1;
}
.map-hero iframe {
    width: 100%; height: 100%; border: none;
}

.driving-info-panel {
    position: absolute;
    right: 40px; top: 50%; transform: translateY(-50%);
    background: var(--panel-bg-dark);
    backdrop-filter: blur(12px);
    padding: 36px; border-radius: 16px;
    max-width: 420px; width: 90%;
    box-shadow: 0 16px 48px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.12);
    z-index: 10; color: var(--text-light);
}

.driving-info-panel h2 {
    font-family: var(--font-heading);
    font-size: 1.8rem; color: var(--accent);
    margin-bottom: 8px; line-height: 1.3;
}
.driving-info-panel h3 {
    font-size: 0.95rem; font-weight: 500;
    color: #aaa; margin-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    padding-bottom: 10px;
}
.driving-info-panel .desc {
    font-size: 0.95rem; line-height: 1.6; color: #ddd; margin-bottom: 16px;
}

/* ============ CONTENT LAYOUTS ============ */
.content {
    position: relative; z-index: 3;
    width: 90%; max-width: 1200px; padding: 40px;
}
.align-center { text-align: center; }
.layout-split { display: flex; justify-content: flex-start; }
.layout-split.right { justify-content: flex-end; }

.text-panel {
    background: var(--panel-bg-dark);
    backdrop-filter: blur(12px);
    padding: 36px; border-radius: 16px;
    max-width: 520px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.12);
    color: var(--text-light);
}

/* ============ TYPOGRAPHY ============ */
h1 {
    font-family: var(--font-heading);
    font-size: 4.5rem; font-weight: 600;
    color: #fff; margin-bottom: 16px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    line-height: 1.1;
}
h2 {
    font-family: var(--font-heading);
    font-size: 2.2rem; color: var(--accent);
    margin-bottom: 8px; line-height: 1.2;
}
h3 {
    font-size: 1rem; font-weight: 500;
    color: #aaa; margin-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    padding-bottom: 10px;
}
.subtitle {
    font-size: 1.3rem; letter-spacing: 2px;
    color: rgba(255,255,255,0.85); margin-bottom: 12px;
}
.desc {
    font-size: 1rem; line-height: 1.65;
    margin-bottom: 16px; color: #ddd;
}

/* ============ DAY BADGE ============ */
.day-badge {
    display: inline-block;
    background: var(--day1); color: #fff;
    font-size: 0.75rem; font-weight: 600;
    letter-spacing: 2px; padding: 4px 14px;
    border-radius: 4px; margin-bottom: 16px;
}
.day-badge.day2 { background: var(--day2); }
.day-badge.day3 { background: var(--day3); }
.day-badge.day4 { background: var(--day4); }

/* ============ FAMILY INFO ============ */
.family-info {
    display: flex; gap: 20px; justify-content: center;
    flex-wrap: wrap; margin-top: 16px;
}
.family-info span {
    background: rgba(255,255,255,0.15);
    padding: 8px 16px; border-radius: 20px;
    font-size: 0.9rem; color: #fff;
}

/* ============ COST TAG ============ */
.cost-tag {
    background: rgba(230, 126, 34, 0.2);
    border: 1px solid rgba(230, 126, 34, 0.4);
    color: var(--accent); padding: 10px 16px;
    border-radius: 8px; font-weight: 600;
    font-size: 0.95rem; margin-top: 16px;
}

/* ============ ALERTS ============ */
.alert {
    padding: 14px 18px; border-radius: 8px;
    font-size: 0.9rem; line-height: 1.5; margin-top: 16px;
}
.alert.tip { background: rgba(46, 204, 113, 0.15); border-left: 4px solid #2ecc71; }
.alert.info { background: rgba(52, 152, 219, 0.15); border-left: 4px solid #3498db; }
.alert.warning { background: rgba(231, 76, 60, 0.2); border-left: 4px solid #e74c3c; }
.mt-2 { margin-top: 12px; }

/* ============ SUMMARY (Final slide) ============ */
.finale { max-width: 480px; }
.summary-section {
    margin-top: 20px; padding: 16px;
    background: rgba(255,255,255,0.06);
    border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);
}
.summary-section h4 {
    font-size: 1rem; color: var(--accent); margin-bottom: 12px;
}
.summary-items {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.summary-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: #ccc;
}
.summary-item .emoji { font-size: 1.2rem; }
.finale-text {
    font-family: var(--font-heading);
    font-size: 1.3rem; font-style: italic;
    color: #fff; margin-top: 24px; text-align: center;
}

/* ============ SCROLL INDICATOR ============ */
.scroll-indicator {
    margin-top: 60px; opacity: 0.7; color: #fff;
}
.scroll-indicator p {
    font-size: 0.85rem; margin-bottom: 8px; letter-spacing: 1px;
}

/* ============ ANIMATIONS ============ */
.animate-fade-up, .animate-slide-right, .animate-slide-left {
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.animate-fade-up { transform: translateY(25px); }
.animate-slide-right { transform: translateX(-40px); }
.animate-slide-left { transform: translateX(40px); }

.slide.active .animate-fade-up { opacity: 1; transform: translateY(0); }
.slide.active .animate-slide-right { opacity: 1; transform: translateX(0); }
.slide.active .animate-slide-left { opacity: 1; transform: translateX(0); }

/* Driving panel also uses active */
.slide-driving.active .driving-info-panel {
    opacity: 1; transform: translateY(-50%) translateX(0);
}

.delay-1 { transition-delay: 0.2s; }
.delay-2 { transition-delay: 0.4s; }
.delay-3 { transition-delay: 0.6s; }

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-10px); }
    60% { transform: translateY(-5px); }
}
.animate-bounce { animation: bounce 2s infinite; }

/* ============ HOTEL PIP (Picture-in-Picture on driving slides) ============ */
.hotel-pip {
    position: absolute;
    bottom: 30px; left: 30px;
    width: 320px; height: 600px;
    border-radius: 12px; overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.6);
    z-index: 10;
    border: 3px solid rgba(255,255,255,0.3);
    transition: all 0.3s ease;
}
.hotel-pip:hover {
    transform: scale(1.05);
    border-color: rgba(255,255,255,0.6);
    box-shadow: 0 12px 36px rgba(0,0,0,0.7);
}
.hotel-pip iframe, .hotel-pip img {
    width: 100%; height: 100%; border: none; object-fit: cover;
}
.hotel-pip-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: rgba(0,0,0,0.75); color: #fff;
    font-size: 0.75rem; font-weight: 600;
    padding: 5px 10px; text-align: center;
    letter-spacing: 0.5px;
}

/* ============ KNOEBELS LAYOUT (Text + Photo Gallery) ============ */
.knoebels-layout {
    display: flex; flex-direction: column; gap: 30px;
    align-items: center; justify-content: center;
    width: 100%; max-width: 1400px; padding-top: 20px;
}
.knoebels-layout .text-panel {
    flex: none; width: 100%; max-width: 1000px;
    text-align: center;
}
.knoebels-layout .text-panel h2, .knoebels-layout .text-panel h3 {
    text-align: center;
}
.knoebels-layout .alert {
    text-align: left; max-width: 800px; margin: 16px auto 0 auto;
}

/* ============ PHOTO GALLERY ============ */
.photo-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px; width: 100%; max-width: 1400px;
}
.gallery-item {
    position: relative; border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    transition: transform 0.3s ease;
}
.gallery-item:hover {
    transform: scale(1.05);
    z-index: 2;
}
.gallery-item img {
    width: 100%; height: 350px;
    object-fit: cover; display: block;
}
.gallery-caption {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.85));
    color: #fff; font-size: 0.85rem; font-weight: 500;
    padding: 30px 15px 12px 15px; text-align: center;
    letter-spacing: 0.5px;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 1200px) {
    .photo-gallery { grid-template-columns: repeat(2, 1fr); max-width: 900px; }
}

@media (max-width: 900px) {
    h1 { font-size: 2.8rem; }
    .layout-split, .layout-split.right { justify-content: center; }
    .text-panel { max-width: 100%; padding: 24px; }
    .driving-info-panel {
        right: 10px; left: 10px; bottom: 10px; top: auto;
        transform: none; max-width: 100%;
    }
    .slide-driving.active .driving-info-panel {
        transform: none;
    }
    #progress-text { font-size: 0.65rem; right: 10px; }
    .family-info span { font-size: 0.8rem; padding: 6px 10px; }
    .hotel-pip { width: 200px; height: 140px; bottom: auto; top: 10px; left: 10px; }
    
    .knoebels-layout { padding: 10px; }
    .gallery-item img { height: 200px; }
    .photo-gallery { grid-template-columns: 1fr; gap: 12px; }
}
